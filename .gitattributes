# 这个 demo 的目标平台是 Linux（Ubuntu 24.04 / ROS 2 Jazzy）。
# 在 Windows 上编辑、提交，但保证仓库里和检出后都是 LF，
# 否则 .sh / .py 的 shebang 会带上 \r，在 Linux 上报 "bad interpreter"。
* text=auto

*.sh           text eol=lf
*.py           text eol=lf
*.sdf          text eol=lf
*.urdf         text eol=lf
*.xacro        text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.rviz         text eol=lf
*.repos        text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
CMakeLists.txt text eol=lf
*.xml          text eol=lf
Makefile       text eol=lf
