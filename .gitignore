# ---- colcon 产物 ----
build/
install/
log/

# ---- 两套算法都是另外 clone 进来的第三方代码，不要提交进来
#      （install_deps.sh / demo.repos 会在目标机器上拉） ----
ros2_ws/src/LIO-SAM/
ros2_ws/src/A-LOAM-ROS2/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 数据 / 中间文件 ----
*.bag
*.db3
*.mcap
*.pcd
*.ply
maps/

# ---- 实验产物：录的原始包体积大，不入库；CSV/图/表要入库 ----
experiments/data/
experiments/bags/
results/_cache/
*.bag.db3

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- 修 Windows 工作区权限时生成的备份，不属于仓库内容 ----
.acl-recovery/

# ---- 测试产物 ----
.pipeline-test/
.nodes-test/
.runbench-test/
.bench-test-tmp/

# ---- PPT 渲染预览 / 调试产物（由 report/build_deck.py 和 LibreOffice 产生） ----
.deck-*/
.deck-selftest/
report/preview/
report/.deck-*.pptx
*.pptx.lock

# 原始数据/日志/图片不入库（体积大、可由脚本重建）；
# 但 results/tables/ 保留在版本控制里 —— 那是实测证据，
# 也是报告能用一份 clone 重新生成的唯一依赖。
results/raw/
results/json/
results/logs/
results/figures/
results/manifest.json

# 演练/临时产物（我自己跑验证时产生的，绝不该进仓库）
.tmp_*
.clone-test/
.figscale/
.deck-*/
