<?xml version="1.0" ?>
<!--
  lab1_room.sdf —— LIO-SAM 教学 demo 的室内场景

  设计要点：
    * 12 m x 12 m 的封闭房间（四面墙），保证激光雷达的射线基本都能打到东西，
      不会产生大量 inf 点；
    * 中间一根方柱 + 四个方墩 + 两面矮墙，提供足够的“角点(edge)”和“平面(surface)”
      特征，LIO-SAM 的特征提取才不会报 "Not enough features"；
    * 场景自带闭环几何（绕柱子一圈就能回到原点），方便演示 loop closure。

  运行：ros2 launch lio_sam_gz_bringup gazebo_lab1.launch.py
-->
<sdf version="1.9">
  <world name="lab1_room">

    <!-- 与 LIO-SAM 参数 imuGravity 保持一致，避免加速度计重力不匹配 -->
    <gravity>0 0 -9.80511</gravity>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ===================== 光照 ===================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.75 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ===================== 地面 ===================== -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 40 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 40 0.2</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== 四面墙 ===================== -->
    <model name="wall_px">
      <static>true</static>
      <pose>6.15 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 12.6 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 12.6 2.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_nx">
      <static>true</static>
      <pose>-6.15 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 12.6 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 12.6 2.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_py">
      <static>true</static>
      <pose>0 6.15 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.6 0.3 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12.6 0.3 2.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_ny">
      <static>true</static>
      <pose>0 -6.15 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.6 0.3 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12.6 0.3 2.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== 中间方柱（闭环用） ===================== -->
    <model name="center_pillar">
      <static>true</static>
      <pose>0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 1.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 2.5</size></box></geometry>
          <material><ambient>0.65 0.35 0.25 1</ambient><diffuse>0.8 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== 四个方墩 ===================== -->
    <model name="box_pp">
      <static>true</static>
      <pose>3.5 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.3 0.55 0.35 1</ambient><diffuse>0.4 0.7 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_pn">
      <static>true</static>
      <pose>3.5 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.3 0.55 0.35 1</ambient><diffuse>0.4 0.7 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_np">
      <static>true</static>
      <pose>-3.5 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.3 0.55 0.35 1</ambient><diffuse>0.4 0.7 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_nn">
      <static>true</static>
      <pose>-3.5 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.3 0.55 0.35 1</ambient><diffuse>0.4 0.7 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== 两面矮墙 ===================== -->
    <model name="low_wall_1">
      <static>true</static>
      <pose>-4.5 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 4.0 1.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 4.0 1.2</size></box></geometry>
          <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.5 0.5 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="low_wall_2">
      <static>true</static>
      <pose>0 -4.5 0.6 0 0 1.5707</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 4.0 1.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 4.0 1.2</size></box></geometry>
          <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.5 0.5 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
